@page
@model LabProject.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (HttpContext.Session.GetString("username") != null)
{
    <div style="text-align:right; margin-bottom: 10px;">
        Welcome, <strong>@HttpContext.Session.GetString("username")</strong> |
        <a href="/Logout">Logout</a>
    </div>
}


<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="FormModel.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FormModel.ClassName" class="control-label"></label>
                <input asp-for="FormModel.ClassName" class="form-control" />
                <span asp-validation-for="FormModel.ClassName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FormModel.StudentCount" class="control-label"></label>
                <input asp-for="FormModel.StudentCount" class="form-control" />
                <span asp-validation-for="FormModel.StudentCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FormModel.Description" class="control-label"></label>
                <input asp-for="FormModel.Description" class="form-control" />
                <span asp-validation-for="FormModel.Description" class="text-danger"></span>
            </div>
            @if (Model.IsEdit)
            {
                <button type="submit" asp-page-handler="Update">Update Class</button>
            }
            else
            {
                <button type="submit" asp-page-handler="Add">Add Class</button>
            }
        </form>
            <form method="get" class="row g-2 mb-3">
                <div class="col">
                    <input asp-for="SearchName" class="form-control" placeholder="Class name…" />
                </div>
                <div class="col">
                    <input asp-for="MinStudents" class="form-control" placeholder="Min students" type="number" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
        </form>

    </div>
    <div class="col-md-6">
        <form method="post" id="exportForm">
            <input type="hidden" name="SearchName" value="@Model.SearchName" />
            <input type="hidden" name="MinStudents" value="@Model.MinStudents" />

            <div style="display:none;">
                <input type="checkbox" name="SelectedColumns" value="ClassName" id="cb-ClassName" />
                <input type="checkbox" name="SelectedColumns" value="StudentCount" id="cb-StudentCount" />
                <input type="checkbox" name="SelectedColumns" value="Description" id="cb-Description" />
            </div>

            <button type="submit" asp-page-handler="ExportAll">Export All</button>
            <button type="submit" asp-page-handler="ExportFiltered">Export Filtered</button>
        </form>


        <table class="table table-striped">
            <thead>
                <tr>
                    <th data-column="ClassName" class="selectable-header">Class Name</th>
                    <th data-column="StudentCount" class="selectable-header">Student #</th>
                    <th data-column="Description" class="selectable-header">Description</th>
                    <th></th> <!-- Action buttons -->
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model.Table.Items)
        {
                <tr>
                    <td>@item.ClassName</td>
                    <td>@item.StudentCount</td>
                    <td>@item.Description</td>
                    <td>
                        <form method="post">
                            <input type="hidden" name="Id" value="@item.Id" />
                            <button asp-page-handler="Edit"
                                    class="btn btn-sm btn-warning">Edit</button>
                            <button asp-page-handler="Delete"
                                    class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
        }
            </tbody>
        </table>
        @if (Model.Table.TotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(Model.Table.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                        asp-route-SearchName="@Model.Table.SearchName"
                        asp-route-MinStudents="@Model.Table.MinStudents"
                        asp-route-PageNumber="@(Model.Table.CurrentPage - 1)">
                            « Prev
                        </a>
                    </li>

        @for (int i = 1; i <= Model.Table.TotalPages; i++)
        {
                    <li class="page-item @(i == Model.Table.CurrentPage ? "active" : "")">
                        <a class="page-link"
                        asp-route-SearchName="@Model.Table.SearchName"
                        asp-route-MinStudents="@Model.Table.MinStudents"
                        asp-route-PageNumber="@i">@i</a>
                    </li>
        }

                    <li class="page-item @(Model.Table.CurrentPage == Model.Table.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                        asp-route-SearchName="@Model.Table.SearchName"
                        asp-route-MinStudents="@Model.Table.MinStudents"
                        asp-route-PageNumber="@(Model.Table.CurrentPage + 1)">
                            Next »
                        </a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</div>

<script>
    document.querySelectorAll('.selectable-header').forEach(th => {
        th.addEventListener('click', () => {
            const col = th.dataset.column;
            const cb = document.getElementById("cb-" + col);
            cb.checked = !cb.checked;

            // Görsel seçili olup olmadığını kontrol et
            th.classList.toggle("selected", cb.checked);
        });
    });
</script>

<style>
    .selectable-header {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .selectable-header.selected {
        background-color: #d0ebff;
    }
</style>

