@page
@model LabProject.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div style="display: flex; justify-content: center; align-items: center; height: 80vh;">
    <div style="min-width: 320px;">
        <h2 style="text-align: center; margin-bottom: 20px;">Login</h2>

        <form method="post">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <label for="Username" style="width: 100px;">Username</label>
                    <input asp-for="Username" id="Username" style="flex: 1;" />
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <label for="Password" style="width: 100px;">Password</label>
                    <input asp-for="Password" id="Password" type="password" style="flex: 1;" />
                </div>

                <div style="display: flex; justify-content: flex-end;">
                    <button type="submit">Login</button>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p style="color:red; text-align: right;">@Model.ErrorMessage</p>
                }
            </div>
        </form>
    </div>
</div>
